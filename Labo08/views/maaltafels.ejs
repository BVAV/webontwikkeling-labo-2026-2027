<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maaltafels</title>
  </head>
  <body>
  <table>
    <tr>
    <% for(let i=1; i<11;i++) { %>
      <th><strong><%= i %></strong></th>
    <% } %>
    </tr>
    <% for(let i=1; i<11;i++) { %>
      <tr>
        <strong><td><%= i %></td></strong>
        <% for(let j=1; j<11;j++) { %>
          <td><%= i*j %></td>
        <% } %>
      </tr>
    <% } %>
  </table>
  </body>
</html>
